def zynq-connect
  target remote :3333
end

def zynq-fsbl-restart
  mon xilinx_ps7_init
end

def zynq-restart
  mon xilinx_ps7_init
  #mon load_image zc706.elf 0x00000000 elf
  load zc706.elf
end

# easily typed shortcuts
# device connect
def dc
  zynq-connect
end
# device restart
def dr
  zynq-restart
end

def dfr
  zynq-fsbl-restart
end


